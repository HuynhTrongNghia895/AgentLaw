OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120
LLM_PROVIDER=shopaikey
OPENAI_BASE_URL=https://api.shopaikey.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=1
OPENAI_SEND_REASONING=true
LUNA_PLANNER_EFFORT=none
LUNA_TOOL_EFFORT=none
LUNA_SYNTHESIS_EFFORT=low
LUNA_CONFLICT_EFFORT=low
LUNA_WEB_SUMMARY_EFFORT=low
ENABLE_GEMINI_FALLBACK=false

# Chỉ cần cấu hình Gemini nếu chủ động bật ENABLE_GEMINI_FALLBACK=true.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# Tavily — Web Agent (X6). Cần pip install tavily-python.
# Để trống -> Web Agent degrade (available()=False), hệ thống vẫn chạy
# bình thường bằng nguồn nội bộ.
TAVILY_API_KEY=
